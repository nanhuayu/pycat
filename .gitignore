# 常见 Python + PyQt6 .gitignore
*.json
# This package seed is copied to ~/.pycat/default_models.json on first use.
!pycat/assets/default_models.json
# Bundled OCR assets require a versioned provenance and integrity manifest.
!pycat/assets/ocr/ppocrv6-small/manifest.json
!pycat/assets/tools/ripgrep/manifest.json
!pycat/assets/web/vendor/manifest.json
!pycat/assets/extensions/browser.json
pycat/assets/tools/ripgrep/windows-x64/

*.zip
*.tar.gz

.env
.env.*
_*.md
temp/
temp_*
tmp/
debug/

.pycat/
.vscode/
.playwright-mcp/
/.playwright-cli/
/output/playwright/

# Byte-compiled / optimized
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so
*.pyd

# Distribution / packaging
.Python
build/
dist/
eggs/
.eggs/
*.egg-info/
.installed.cfg
pip-wheel-metadata/

# PyInstaller
*.spec
release/
/showcase/output/
/showcase/voice/*
/showcase/recordings/*
/showcase/music/*

# Virtual environments
venv/
ENV/
env/
.venv/
.ENV/
env.bak/
venv.bak/

# Editor/IDE
.idea/
*.sublime-workspace
*.sublime-project

# Pytest / coverage / tox
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Logs and databases
*.log
*.sqlite3
*.db

# OS files
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# Qt / PyQt generated files (optional: ignore if you generate UI/resources at build)
ui_*.py
*_rc.py
*.qmake.stash
*.pro.user*
Makefile.Release
Makefile.Debug

# Misc
*.bak
*.swp
*~
