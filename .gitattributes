# Auto detect text files and use LF in repo, CRLF on checkout (Windows default)
* text=auto

# Markdown is also kept as LF in the worktree so docs/check_docs.py is reproducible.
*.py text
*.md text eol=lf
*.txt text
*.json text
*.yaml text
*.yml text
*.toml text
*.cfg text
*.ini text
*.bat text
*.ps1 text
*.cfg text
*.css text
*.html text
*.js text
*.svg text
*.gitignore text

# Binary files - never touch
*.png binary
*.ico binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.woff binary
*.woff2 binary
*.eot binary
*.ttf binary
*.otf binary
*.pdf binary
