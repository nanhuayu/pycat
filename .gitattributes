# Auto detect text files and use LF in repo, CRLF on checkout (Windows default)
* text=auto

# Markdown is also kept as LF in the worktree so docs/check_docs.py is reproducible.
*.py text
*.md text eol=lf
*.txt text
*.json text
*.yaml text
*.yml text
*.toml text
*.cfg text
*.ini text
*.bat text
*.ps1 text
*.cfg text
*.css text
*.html text
*.js text
pycat/assets/web/vendor/* text eol=lf
*.svg text
# The terminal logo records the canonical mark's byte digest.
pycat/assets/pycat.svg text eol=lf
# Byte-stable prototype exports are checked against their native owners.
prototypes/workbench/assets/pycat.svg text eol=lf
prototypes/workbench/css/theme.generated.css text eol=lf
prototypes/workbench/js/native-contract.js text eol=lf
*.gitignore text

# Binary files - never touch
*.png binary
*.ico binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.woff binary
*.woff2 binary
*.eot binary
*.ttf binary
*.otf binary
*.pdf binary
*.onnx binary
*.qm binary
pycat/assets/translations/*.ts text eol=lf
