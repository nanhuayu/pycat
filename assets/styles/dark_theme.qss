/* PyCat Dark Theme - Unified color tokens only */

QMainWindow,
QDialog,
QWidget:window,
#central_widget,
#main_splitter,
#chat_container,
ChatView,
#messages_scroll,
#messages_container,
#settings_content,
QScrollArea#settings_page_scroll {
    background-color: #16161a;
    color: #ececf1;
}

QWidget,
QLabel {
    color: #ececf1;
}

QLabel[muted="true"],
QLabel#settings_page_description,
QLabel#model_indicator,
QLabel#artifact_meta,
QLabel#collapse_summary,
QLabel#tool_detail_label,
QLabel#stats_subtitle,
QLabel#stat_label,
QLabel#editor_role_label,
QLabel#provider_status_label {
    color: #a1a1ad;
}

QLabel[heading="true"],
QLabel#settings_page_title,
QLabel#message_role,
QLabel#chat_empty_title,
QLabel#chat_empty_tip_title,
QLabel#artifact_title,
QLabel#collapse_title,
QLabel#task_text,
QLabel#runtime_title,
QLabel#stat_value {
    color: #f4f4f6;
}

/* Menus */
QMenuBar,
QMenu {
    background-color: #1c1c22;
    color: #ececf1;
    border: 1px solid #30303a;
}

QMenu QWidget,
QMenu QLabel {
    background-color: #1c1c22;
    color: #ececf1;
}

QMenuBar {
    border-width: 0 0 1px 0;
}

QMenuBar::item,
QMenu::item {
    background-color: transparent;
    color: #ececf1;
}

QMenuBar::item:selected,
QMenu::item:selected {
    background-color: #332b47;
    color: #ddd6fe;
}

QMenu::item:disabled {
    color: #6f6f7a;
}

QMenu::separator {
    background-color: #1c1c22;
    border-top: 1px solid #30303a;
}

/* Shell surfaces */
#sidebar,
Sidebar,
#chat_header,
#input_container,
InputArea,
#settings_sidebar,
StatsPanel,
#stats_panel {
    background-color: #1c1c22;
}

#sidebar,
Sidebar,
#settings_sidebar {
    border-right: 1px solid #2b2b34;
}

StatsPanel,
#stats_panel {
    border-left: 1px solid #2b2b34;
}

#chat_header,
#input_container,
InputArea {
    border-color: #2b2b34;
}

#chat_header {
    border-bottom: 1px solid #2b2b34;
}

#input_container,
InputArea {
    border-top: 1px solid #2b2b34;
}

#sidebar_header,
#sidebar_footer,
#conversation_list,
QScrollArea#stats_scroll,
QWidget#stats_scroll_content,
QScrollArea#stats_scroll QWidget,
#input_wrapper,
QScrollArea {
    background-color: transparent;
    border: none;
}

/* Primary controls */
QPushButton,
QPushButton#import_btn {
    background-color: #202028;
    color: #ececf1;
    border: 1px solid #343440;
}

QPushButton:hover,
QPushButton#import_btn:hover {
    background-color: #262631;
    border-color: #514a70;
}

QPushButton[primary="true"],
QPushButton#new_chat_btn,
QPushButton#send_btn,
QToolButton#send_btn {
    background-color: #8b5cf6;
    color: #ffffff;
    border: 1px solid #8b5cf6;
}

QPushButton[primary="true"]:hover,
QPushButton#new_chat_btn:hover,
QPushButton#send_btn:hover,
QToolButton#send_btn:hover {
    background-color: #7c3aed;
    border-color: #7c3aed;
}

QPushButton:disabled,
QToolButton:disabled,
QPushButton#send_btn:disabled,
QToolButton#send_btn:disabled {
    background-color: #262631;
    color: #6f6f7a;
    border-color: #30303a;
}

QPushButton[danger="true"] {
    background-color: rgba(220, 38, 38, 0.16);
    color: #fca5a5;
    border-color: rgba(220, 38, 38, 0.34);
}

QPushButton[danger="true"]:hover {
    background-color: rgba(220, 38, 38, 0.24);
}

QPushButton#settings_action_btn {
    background-color: #202028;
    color: #ececf1;
    border: 1px solid #343440;
}

QPushButton#settings_action_btn:hover {
    background-color: #262631;
    border-color: #514a70;
}

QPushButton#settings_action_btn[primary="true"] {
    background-color: #8b5cf6;
    color: #ffffff;
    border-color: #8b5cf6;
}

QPushButton#settings_action_btn[danger="true"] {
    background-color: rgba(220, 38, 38, 0.16);
    color: #fca5a5;
    border-color: rgba(220, 38, 38, 0.34);
}

QToolButton,
QToolButton#toolbar_btn,
QToolButton#title_tool_btn,
QToolButton#collapse_toggle,
QToolButton#add_task_btn,
QToolButton#task_done_btn,
QToolButton#task_delete_btn {
    background-color: transparent;
    color: #a1a1ad;
    border: 1px solid transparent;
}

QToolButton:hover,
QToolButton#toolbar_btn:hover,
QToolButton#title_tool_btn:hover,
QToolButton#title_tool_btn:checked,
QToolButton#collapse_toggle:hover,
QToolButton#add_task_btn:hover,
QToolButton#task_done_btn:hover,
QToolButton#task_delete_btn:hover {
    background-color: #332b47;
    color: #ddd6fe;
    border-color: #514a70;
}

QToolButton#toolbar_btn:checked {
    background-color: #3b3157;
    color: #ffffff;
    border-color: #6d5db0;
}

/* Form controls */
QComboBox,
QLineEdit,
QTextEdit,
QPlainTextEdit,
QSpinBox,
QDoubleSpinBox,
QListWidget,
QTableWidget,
QTabWidget::pane {
    background-color: #202028;
    color: #ececf1;
    border: 1px solid #343440;
    selection-background-color: #7c3aed;
    selection-color: #ffffff;
}

QComboBox:hover,
QLineEdit:hover,
QTextEdit:hover,
QPlainTextEdit:hover,
QSpinBox:hover,
QDoubleSpinBox:hover {
    border-color: #514a70;
}

QComboBox:focus,
QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QLineEdit#task_input_edit:focus {
    border-color: #a78bfa;
}

QComboBox::drop-down {
    background-color: transparent;
    border: none;
}

QComboBox::down-arrow {
    image: url("assets/icons/chevron-down-light.svg");
}

QComboBox QAbstractItemView,
QListView#combo_popup_view,
QAbstractItemView#combo_popup_view {
    background-color: #202028;
    color: #ececf1;
    border: 1px solid #343440;
    selection-background-color: #7c3aed;
    selection-color: #ffffff;
}

QListView#combo_popup_view::item,
QAbstractItemView#combo_popup_view::item {
    background-color: transparent;
    color: #ececf1;
}

QListView#combo_popup_view::item:hover,
QAbstractItemView#combo_popup_view::item:hover,
QListWidget::item:hover {
    background-color: #2b2934;
    color: #ffffff;
}

QListWidget::item:selected,
QListView#combo_popup_view::item:selected,
QAbstractItemView#combo_popup_view::item:selected {
    background-color: #332b47;
    color: #ffffff;
}

QListWidget#settings_nav,
QListWidget#conversation_list {
    background-color: transparent;
    border: none;
}

QListWidget#settings_nav::item:selected,
QListWidget#settings_nav::item:hover:selected,
#conversation_list::item:selected {
    background-color: #332b47;
    color: #ddd6fe;
}

QListWidget#settings_nav::item:hover:!selected,
#conversation_list::item:hover {
    background-color: #25252d;
    color: #ececf1;
}

QListWidget#settings_list {
    background-color: #202028;
    border: 1px solid #30303a;
}

QCheckBox {
    color: #ececf1;
}

QCheckBox::indicator {
    background-color: transparent;
    border: 1px solid #514a70;
}

QCheckBox::indicator:checked {
    background-color: #8b5cf6;
    border-color: #8b5cf6;
}

QGroupBox,
QFrame#settings_detail_card,
QFrame#collapse_section,
QFrame#task_card,
QFrame#artifact_row,
QFrame#runtime_strip,
QFrame#stat_card,
QFrame#chat_empty_card,
QFrame#chat_empty_tip_card,
#streaming_container,
QFrame#image_preview_item,
QFrame#image_edit_item {
    background-color: #202028;
    border: 1px solid #30303a;
}

QGroupBox::title {
    background-color: #202028;
    color: #f4f4f6;
}

QGroupBox QWidget {
    background-color: transparent;
}

QFrame#collapse_section:hover,
QFrame#settings_detail_card:hover,
QFrame#task_card:hover,
QFrame#artifact_row:hover {
    background-color: #262631;
    border-color: #3d3a4c;
}

QLabel#task_status_icon[status="completed"] {
    color: #22c55e;
}

QLabel#task_status_icon[status="cancelled"] {
    color: #a1a1ad;
}

QLabel#task_status_icon[status="blocked"] {
    color: #fbbf24;
}

QFrame#chat_header_separator {
    background-color: #2b2b34;
    border: none;
}

QPushButton#work_dir_btn,
QLabel#context_indicator,
QLabel#runtime_indicator,
QFrame#chat_nav_group,
QComboBox#mode_combo,
QComboBox#provider_combo,
QComboBox#model_combo,
QComboBox#bottom_model_selector,
QLineEdit#task_input_edit {
    background-color: #222127;
    color: #e5e1f2;
    border: 1px solid #383543;
}

QPushButton#work_dir_btn:hover,
QLabel#context_indicator:hover,
QLabel#runtime_indicator:hover,
QFrame#chat_nav_group:hover,
QComboBox#mode_combo:hover,
QComboBox#bottom_model_selector:hover {
    background-color: #2b2934;
    border-color: #514a70;
    color: #ddd6fe;
}

QLabel#runtime_indicator[active="true"] {
    background-color: #332b47;
    color: #ddd6fe;
    border-color: #514a70;
}

/* Messages and tool rows */
MessageWidget {
    border: none;
}

MessageWidget[role="assistant"] {
    background-color: #1c1c22;
}

MessageWidget[role="user"] {
    background-color: #252236;
}

QTextBrowser#message_content,
QTextEdit#message_input {
    background-color: transparent;
    color: #ececf1;
    border: none;
}

QLabel#message_badge {
    color: #a1a1ad;
    background-color: #262631;
}

QWidget#subagent_trace_content {
    background-color: #1d1b27;
    border-left-color: #a78bfa;
}

QToolButton#msg_edit_btn,
QToolButton#msg_copy_btn,
QToolButton#msg_delete_btn {
    background-color: transparent;
    border: 1px solid transparent;
    color: #a1a1ad;
}

QToolButton#msg_edit_btn:hover,
QToolButton#msg_copy_btn:hover {
    background-color: #332b47;
    border-color: #514a70;
}

QToolButton#msg_delete_btn {
    color: #fca5a5;
}

QToolButton#msg_delete_btn:hover {
    background-color: rgba(220, 38, 38, 0.18);
    border-color: rgba(220, 38, 38, 0.34);
}

QPushButton#thinking_toggle,
QToolButton#thinking_toggle,
QPushButton#tool_call_header,
QToolButton#tool_call_header,
QPushButton#tool_call_header[kind="tool"],
QToolButton#tool_call_header[kind="tool"],
QPushButton#tool_call_header[kind="capability"],
QToolButton#tool_call_header[kind="capability"],
QPushButton#tool_call_header[kind="subagent"],
QToolButton#tool_call_header[kind="subagent"] {
    background-color: transparent;
    border: none;
    color: #a1a1ad;
    text-align: left;
}

QPushButton#thinking_toggle:hover,
QToolButton#thinking_toggle:hover,
QPushButton#tool_call_header:hover,
QToolButton#tool_call_header:hover {
    background-color: #25252d;
    color: #ddd6fe;
}

QTextBrowser#thinking_content,
QTextBrowser#tool_args_view,
QTextBrowser#tool_result_view,
QLabel#settings_hint {
    background-color: #24242e;
    color: #e6e6eb;
    border: 1px solid #343440;
}

/* Status colors */
QLabel#provider_status_label[state="success"] {
    color: #22c55e;
}

QLabel#provider_status_label[state="error"] {
    color: #fca5a5;
}

QLabel#provider_status_label[state="muted"] {
    color: #a1a1ad;
}

QLabel#message_error_label,
QLabel#validation_error_label {
    color: #fca5a5;
}

QLabel#file_thumb,
QLabel#file_name_lbl {
    color: #a1a1ad;
}

QListWidget#file_completer_popup {
    background-color: #202028;
    border: 1px solid #343440;
}

QHeaderView::section,
QTabBar::tab {
    background-color: #202028;
    color: #ececf1;
    border: 1px solid #30303a;
}

QTabBar::tab:selected {
    background-color: #262631;
    color: #ddd6fe;
}

QToolTip {
    background-color: #202028;
    color: #ececf1;
    border: 1px solid #514a70;
}

QScrollBar:vertical,
QScrollBar:horizontal {
    background-color: transparent;
}

QScrollBar::handle:vertical,
QScrollBar::handle:horizontal {
    background-color: #343440;
}

QScrollBar::handle:vertical:hover,
QScrollBar::handle:horizontal:hover,
QSplitter::handle:hover {
    background-color: #514a70;
}

QSplitter::handle {
    background-color: #2b2b34;
}
