/* PyCat Theme - color tokens are injected by gui.utils.theme */

QMainWindow,
QDialog,
QWidget:window,
#central_widget,
#main_splitter,
#chat_container,
ChatView,
#messages_scroll,
#messages_container,
#settings_content,
QScrollArea#settings_page_scroll {
    background-color: $app_bg;
    color: $text;
}

QWidget, QLabel { color: $text; }

QLabel[muted="true"],
QLabel#settings_page_description,
QLabel#model_indicator,
QLabel#collapse_summary,
QLabel#tool_detail_label,
QLabel#inspector_subtitle,
QLabel#stat_label,
QLabel#metric_label,
QLabel#empty_state_description,
QLabel#editor_role_label,
QLabel#shortcut_group_label,
QLabel#provider_status_label {
    color: $muted;
}

QLabel#shortcut_key {
    background-color: $surface_alt;
    color: $text;
    border: 1px solid $border;
}

QLabel[heading="true"],
QLabel#settings_page_title,
QLabel#message_role,
QLabel#chat_empty_title,
QLabel#chat_empty_tip_title,
QLabel#collapse_title,
QLabel#task_text,
QLabel#runtime_title,
QLabel#stat_value,
QLabel#metric_value,
QLabel#empty_state_title {
    color: $text;
}

/* Menus */
QMenuBar,
QMenu {
    background-color: $window;
    color: $text;
    border: 1px solid $border;
}

QMenu QWidget, QMenu QLabel { background-color: $window; color: $text; }

QMenuBar { border-width: 0 0 1px 0; }

QMenuBar::item, QMenu::item { background-color: transparent; color: $text; }

QMenuBar::item:selected, QMenu::item:selected { background-color: $primary_hover; color: $selected_text; }

QMenu::item:disabled { color: $disabled; }

QMenu::separator { background-color: $window; border-top: 1px solid $border; }

/* Shell surfaces */
#sidebar,
Sidebar,
#chat_header,
#input_container,
InputArea,
#settings_sidebar,
InspectorPanel,
#inspector_panel {
    background-color: $window;
}

#sidebar, Sidebar, #settings_sidebar { border-right: 1px solid $border; }

InspectorPanel, #inspector_panel { border-left: 1px solid $border; }

#chat_header,
#input_container,
InputArea {
    border-color: $border;
}

#chat_header {
    border-bottom: 1px solid $border;
}

#input_container,
InputArea {
    border-top: 1px solid $border;
}

#sidebar_header,
#sidebar_footer,
#conversation_list,
QScrollArea#inspector_scroll,
QWidget#inspector_scroll_content,
QScrollArea#inspector_scroll QWidget,
#input_wrapper,
QScrollArea {
    background-color: transparent;
    border: none;
}

/* Primary controls */
QPushButton,
QPushButton#import_btn {
    background-color: $surface;
    color: $text;
    border: 1px solid $control_border;
}

QPushButton:hover,
QPushButton#import_btn:hover {
    background-color: $surface_hover;
    border-color: $selected_border;
}

QPushButton[primary="true"],
QPushButton#new_chat_btn,
QPushButton#send_btn,
QToolButton#send_btn {
    background-color: $primary;
    color: $on_primary;
    border: 1px solid $primary;
}

QPushButton[primary="true"]:hover,
QPushButton#new_chat_btn:hover,
QPushButton#send_btn:hover,
QToolButton#send_btn:hover {
    background-color: $primary_strong;
    border-color: $primary_strong;
}

QPushButton:disabled,
QToolButton:disabled,
QPushButton#send_btn:disabled,
QToolButton#send_btn:disabled {
    background-color: $surface_alt;
    color: $disabled;
    border-color: $border;
}

QPushButton[danger="true"] {
    background-color: $danger_bg;
    color: $error;
    border-color: $danger_border;
}

QPushButton[danger="true"]:hover {
    background-color: $danger_hover;
}

QPushButton#settings_action_btn {
    background-color: $surface;
    color: $text;
    border: 1px solid $control_border;
}

QPushButton#settings_action_btn:hover {
    background-color: $surface_hover;
    border-color: $selected_border;
}

QPushButton#settings_action_btn[primary="true"] {
    background-color: $primary;
    color: $on_primary;
    border-color: $primary;
}

QPushButton#settings_action_btn[danger="true"] {
    background-color: $danger_bg;
    color: $error;
    border-color: $danger_border;
}

QToolButton,
QToolButton#toolbar_btn,
QToolButton#title_tool_btn,
QToolButton#collapse_toggle,
QToolButton#add_task_btn,
QToolButton#task_done_btn,
QToolButton#task_delete_btn {
    background-color: transparent;
    color: $muted;
    border: 1px solid transparent;
}

QToolButton:hover,
QToolButton#toolbar_btn:hover,
QToolButton#title_tool_btn:hover,
QToolButton#title_tool_btn:checked,
QToolButton#collapse_toggle:hover,
QToolButton#add_task_btn:hover,
QToolButton#task_done_btn:hover,
QToolButton#task_delete_btn:hover {
    background-color: $primary_hover;
    color: $selected_text;
    border-color: $selected_border;
}

QToolButton#toolbar_btn:checked {
    background-color: $selected;
    color: $selected_text;
    border-color: $selected_border;
}

QToolButton#toolbar_btn[nav="true"]:hover { background-color: $primary_hover; color: $selected_text; border-color: $selected_border; }

/* Form controls */
QComboBox,
QLineEdit,
QTextEdit,
QPlainTextEdit,
QSpinBox,
QDoubleSpinBox,
QListWidget,
QTreeWidget,
QTableWidget,
QTabWidget::pane {
    background-color: $surface;
    color: $text;
    border: 1px solid $control_border;
    selection-background-color: $primary;
    selection-color: $on_primary;
}

QComboBox:hover,
QLineEdit:hover,
QTextEdit:hover,
QPlainTextEdit:hover,
QSpinBox:hover,
QDoubleSpinBox:hover {
    border-color: $selected_border;
}

QComboBox:focus,
QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QLineEdit#task_input_edit:focus {
    border-color: $primary;
}

QComboBox::drop-down {
    background-color: transparent;
    border: none;
}

QComboBox::down-arrow {
    image: url("$chevron_icon");
}

QComboBox QAbstractItemView,
QListView#combo_popup_view,
QAbstractItemView#combo_popup_view {
    background-color: $surface;
    color: $text;
    border: 1px solid $control_border;
    selection-background-color: $primary;
    selection-color: $on_primary;
}

QListView#combo_popup_view::item,
QAbstractItemView#combo_popup_view::item {
    background-color: transparent;
    color: $text;
}

QListView#combo_popup_view::item:hover,
QAbstractItemView#combo_popup_view::item:hover,
QListWidget::item:hover {
    background-color: $primary_hover;
    color: $selected_text;
}

QListWidget::item:selected,
QListView#combo_popup_view::item:selected,
QAbstractItemView#combo_popup_view::item:selected {
    background-color: $selected;
    color: $selected_text;
}

QListWidget#settings_nav,
QListWidget#conversation_list {
    background-color: transparent;
    border: none;
}

QListWidget#settings_nav::item:selected,
QListWidget#settings_nav::item:hover:selected,
#conversation_list::item:selected {
    background-color: $selected;
    color: $selected_text;
}

QListWidget#settings_nav::item:hover:!selected,
#conversation_list::item:hover {
    background-color: $surface_hover;
    color: $text;
}

QListWidget#settings_nav::item:disabled {
    background-color: transparent;
    color: $muted;
}

QListWidget#settings_list {
    background-color: $surface;
    border: 1px solid $border;
}

QCheckBox {
    color: $text;
}

QCheckBox::indicator,
QTreeWidget#permission_matrix::indicator,
QListWidget#model_catalog_list::indicator {
    background-color: $transparent;
    border: 1px solid $selected_border;
}

QCheckBox::indicator:checked,
QTreeWidget#permission_matrix::indicator:checked,
QListWidget#model_catalog_list::indicator:checked {
    background-color: $primary;
    border-color: $primary;
    image: url("$checkbox_check_icon");
}

QGroupBox,
QFrame#settings_detail_card,
QFrame#settings_form_section,
QFrame#collapse_section,
QFrame#task_card,
QFrame#runtime_strip,
QFrame#stat_card,
QFrame#metric_card,
QFrame#empty_state,
QFrame#chat_empty_card,
QFrame#chat_empty_tip_card,
#streaming_container,
QFrame#image_preview_item,
QFrame#image_edit_item {
    background-color: $surface;
    border: 1px solid $border;
}

QFrame#settings_section_body {
    background-color: transparent;
    border: none;
}

QFrame#settings_list_panel {
    background-color: transparent;
    border: none;
}

QGroupBox::title {
    background-color: $surface;
    color: $text;
}

QGroupBox QWidget {
    background-color: transparent;
}

QFrame#collapse_section:hover,
QFrame#settings_detail_card:hover {
    background-color: $surface_alt;
    border-color: $border;
}

QFrame#task_card:hover,
QToolButton#icon_tool_button:hover {
    background-color: $primary_hover;
    border-color: $selected_border;
}

QLabel#status_pill { background-color: $primary_hover; color: $selected_text; }
QLabel#status_pill[tone="success"] { color: $success; }
QLabel#status_pill[tone="danger"] { color: $error; }
QLabel#status_pill[tone="warning"] { color: $warning; }

QLabel#task_status_icon[status="completed"] {
    color: $success;
}

QLabel#task_status_icon[status="cancelled"] {
    color: $muted;
}

QLabel#task_status_icon[status="blocked"] {
    color: $warning;
}

QFrame#chat_header_separator {
    background-color: $border;
    border: none;
}

QPushButton#work_dir_btn,
QLabel#context_indicator,
QLabel#runtime_indicator,
QFrame#chat_nav_group,
QComboBox#mode_combo,
QComboBox#provider_combo,
QComboBox#model_combo,
QComboBox#bottom_model_selector,
QLineEdit#task_input_edit {
    background-color: $surface_alt;
    color: $text;
    border: 1px solid $border;
}

QPushButton#work_dir_btn:hover,
QLabel#context_indicator:hover,
QLabel#runtime_indicator:hover,
QFrame#chat_nav_group:hover,
QComboBox#mode_combo:hover,
QComboBox#bottom_model_selector:hover {
    background-color: $primary_hover;
    border-color: $selected_border;
    color: $selected_text;
}

QLabel#runtime_indicator[active="true"] {
    background-color: $primary_hover;
    color: $selected_text;
    border-color: $selected_border;
}

/* Messages and tool rows */
MessageWidget {
    border: none;
}

MessageWidget[role="assistant"] {
    background-color: $surface;
}

MessageWidget[role="user"] {
    background-color: $selected;
}

QTextBrowser#message_content,
QTextEdit#message_input {
    background-color: transparent;
    color: $text;
    border: none;
    selection-background-color: $primary;
    selection-color: $on_primary;
}

QLabel#message_badge {
    color: $muted;
    background-color: $surface_hover;
}

QWidget#subagent_trace_content {
    background-color: $surface_alt;
    border-left-color: $primary;
}

QToolButton#msg_edit_btn,
QToolButton#msg_copy_btn,
QToolButton#msg_delete_btn {
    background-color: transparent;
    border: 1px solid transparent;
    color: $muted;
}

QToolButton#msg_edit_btn:hover,
QToolButton#msg_copy_btn:hover {
    background-color: $primary_hover;
    border-color: $selected_border;
}

QToolButton#msg_delete_btn {
    color: $error;
}

QToolButton#msg_delete_btn:hover {
    background-color: $danger_bg;
    border-color: $danger_border;
}

QPushButton#thinking_toggle,
QToolButton#thinking_toggle,
QPushButton#tool_call_header,
QToolButton#tool_call_header,
QPushButton#tool_call_header[kind="tool"],
QToolButton#tool_call_header[kind="tool"],
QPushButton#tool_call_header[kind="capability"],
QToolButton#tool_call_header[kind="capability"],
QPushButton#tool_call_header[kind="subagent"],
QToolButton#tool_call_header[kind="subagent"] {
    background-color: transparent;
    border: none;
    color: $muted;
    text-align: left;
}

QPushButton#thinking_toggle:hover,
QToolButton#thinking_toggle:hover,
QPushButton#tool_call_header:hover,
QToolButton#tool_call_header:hover {
    background-color: $surface_hover;
    color: $selected_text;
}

QTextBrowser#thinking_content,
QTextBrowser#tool_args_view,
QTextBrowser#tool_result_view,
QLabel#settings_hint {
    background-color: $surface_alt;
    color: $text;
    border: 1px solid $control_border;
    selection-background-color: $primary;
    selection-color: $on_primary;
}

QFrame#tool_capsule_row {
    background-color: $surface_alt;
    border: 1px solid $control_border;
}

QFrame#tool_capsule_row:hover {
    background-color: $primary_hover;
    border-color: $selected_border;
}

QLabel#tool_capsule_title {
    color: $text;
}

QLabel#tool_capsule_meta {
    color: $muted;
}

QLabel#tool_capsule_icon[status="completed"],
QLabel#tool_capsule_icon[status="running"],
QLabel#tool_capsule_icon[status="partial"] {
    color: $primary;
}

QLabel#tool_capsule_icon[status="failed"] {
    color: $error;
}

QPushButton#assistant_run_toggle {
    color: $muted;
    background-color: transparent;
    border: none;
}
QPushButton#assistant_run_toggle:hover {
    color: $selected_text;
    background-color: $primary_hover;
}
QFrame#assistant_run_process {
    border-left-color: $control_border;
}
QFrame#message_widget[embedded="true"] {
    background-color: transparent;
    border: none;
}

/* Status colors */
QLabel#provider_status_label[state="success"] {
    color: $success;
}

QLabel#provider_status_label[state="error"] {
    color: $error;
}

QLabel#provider_status_label[state="muted"] {
    color: $muted;
}

QLabel#message_error_label,
QLabel#validation_error_label {
    color: $error;
}

QLabel#file_thumb,
QLabel#file_name_lbl {
    color: $muted;
}

QListWidget#file_completer_popup {
    background-color: $surface;
    border: 1px solid $control_border;
}

QHeaderView::section,
QTabBar::tab {
    background-color: $surface;
    color: $text;
    border: 1px solid $border;
}

QTabBar::tab:selected {
    background-color: $surface_hover;
    color: $selected_text;
}

QToolTip {
    background-color: $surface;
    color: $text;
    border: 1px solid $selected_border;
}

QScrollBar:vertical,
QScrollBar:horizontal {
    background-color: transparent;
}

QScrollBar::handle:vertical,
QScrollBar::handle:horizontal {
    background-color: $border;
}

QScrollBar::handle:vertical:hover,
QScrollBar::handle:horizontal:hover,
QSplitter::handle:hover {
    background-color: $selected_border;
}

QSplitter::handle {
    background-color: $border;
}
